# Maintainer: Himanshu Kumar <himanshujsr462@gmail.com>
#
# Arch Linux / AUR PKGBUILD for hmx.
#
# To submit this to the AUR as the package "hmx" (the file must be named
# PKGBUILD there):
#   git clone https://aur.archlinux.org/hmx.git && cd hmx
#   cp <this repo>/packaging/arch/PKGBUILD .
#   makepkg --printsrcinfo > .SRCINFO   # commit .SRCINFO too
#   git add PKGBUILD .SRCINFO && git commit -m 'hmx 0.10.0' && git push
#
# The sha256 below pins the GitHub source tarball for the v0.10.0 tag, which
# is why it cannot be 'SKIP' — AUR rejects that. tests/run_packaging_tests.sh
# enforces the 64-hex form and keeps pkgver in step with CMakeLists.txt.
pkgname=hmx
pkgver=0.10.0
pkgrel=1
pkgdesc="HMX — a small statically typed systems language that transpiles to C"
arch=('x86_64')
url="https://github.com/himanshu-2010/hmx-lang"
license=('MIT')
# gcc is a runtime dependency: `hmx run` transpiles to C and shells out to a C
# compiler. Everything else is only needed to build hmx itself, so it belongs in
# makedepends -- Arch installs runtime deps on the user's machine for good.
depends=('gcc')
makedepends=('cmake' 'ninja' 'flex' 'bison' 'git')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/himanshu-2010/hmx-lang/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('bafbf0023bbf6b72d4683c17bf5944af1e1e859fc75fe91ae1d6d8ff958bb12a')

# The source tarball is the primary input. If it is unavailable (a mirror or
# a local checkout, e.g. when packaging straight from a git clone), fall back
# to the repository itself. Resolved in a function rather than at file scope so
# that `makepkg --printsrcinfo` stays free of side effects.
#
# The top directory inside GitHub's source tarball is named after the repository
# and the commit ("himanshu-2010-hmx-lang-500dfa6"), not "hmx-lang". Assuming
# the name made this fall through to the git clone on every single build while
# still looking like it used the pinned tarball -- so the sha256sums above was
# checked by makepkg and then never actually built from. Locate the tree rather
# than guess at it.
_src() {
  local d
  if [ -f "${srcdir}/CMakeLists.txt" ]; then
    printf '%s' "${srcdir}"
    return
  fi
  for d in "${srcdir}"/*/; do
    if [ -f "${d}CMakeLists.txt" ]; then
      printf '%s' "${d%/}"
      return
    fi
  done
  printf '%s' "${srcdir}/hmx-lang"
}

prepare() {
  # A no-op on the normal path; only fires when the tarball yielded no usable
  # tree, which _src() then resolves to the clone destination below.
  if [ ! -f "$(_src)/CMakeLists.txt" ]; then
    git clone --depth 1 --branch "v${pkgver}" \
      "https://github.com/himanshu-2010/hmx-lang.git" "${srcdir}/hmx-lang"
  fi
}

build() {
  cmake -S "$(_src)" -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

# The suites are the real check, but they are slow on a shared build host;
# upstream CI runs them for every push. Here, one program is enough to catch a
# broken compiler, an unusable codegen, or a missing runtime.
check() {
  local f
  f="$(mktemp --suffix=.hmx)"
  cat > "$f" <<'EOF'
struct Point {
    x: int
    y: int
}

fn main() -> int {
    let p = Point(3, 4)
    if (p.x * p.x + p.y * p.y == 25) {
        print("packaging check ok")
    } else {
        return 1
    }
    return 0
}
EOF
  ./build/hmx run "$f"
  rm -f "$f"
}

package() {
  # DESTDIR is an environment variable, not a flag: `cmake --install` has no
  # --destdir option and fails with "Unknown argument". Found by actually
  # running makepkg, which is the only way this shows up — the manifest parses
  # fine, and the build and check() both succeed first, so it fails late and
  # only on a real Arch machine.
  # build() already set CMAKE_INSTALL_PREFIX=/usr, so this lands in
  # $pkgdir/usr/bin/hmx and pacman owns /usr.
  DESTDIR="$pkgdir" cmake --install build
}
