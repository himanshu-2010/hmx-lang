fn greet(name: text) {
    print(name)
}

fn add(a: int, b: int) -> int {
    return a + b
}

fn double_it(x: int) -> int {
    return x * 2
}

fn main() {
    greet("Boss")
    let sum: int = add(3, 4)
    print(sum)
    print(double_it(21))
    let total: int = add(add(1, 2), 3)
    print(total)
    if (double_it(2) == 4) {
        print("doubled ok")
    }
}
