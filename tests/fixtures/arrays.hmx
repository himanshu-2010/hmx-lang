fn sum(a: [int]) -> int {
    let total = 0
    let i = 0
    while (i < length(a)) {
        total += a[i]
        i++
    }
    return total
}

fn main() {
    let scores: [int] = [10, 20, 30]
    print(scores[0])
    print(scores[2])
    print(length(scores))

    let names: [text] = ["alice", "bob"]
    print(names[1])

    let empty: [int] = []
    print(length(empty))

    let inferred = [1, 2, 3, 4]
    print(length(inferred))

    scores[1] = 99
    print(scores[1])

    let total = sum(scores)
    print(total)

    const fixed: [int] = [5, 6]
    print(fixed[0])
}
