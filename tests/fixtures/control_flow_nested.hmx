fn main() {
    let sum = 0
    loop(3) {
        loop(4) {
            sum += 1
        }
    }
    print(sum) // 12

    let flag = true
    let count = 0
    if (flag) {
        if (sum == 12) {
            loop(5) {
                count += 2
            }
        } else {
            count = 999
        }
    }
    print(count) // 10
}
