fn shout(s: text) -> text {
    return s + "!"
}

fn wrap(s: text, pre: text, post: text) -> text {
    return pre + s + post
}

fn count_vowels(s: text) -> int {
    let n = 0
    for (let i = 0; i < length(s); i += 1) {
        let ch = s[i]
        if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') {
            n += 1
        }
    }
    return n
}

fn main() -> int {
    let a = "hello"
    let b = "world"
    print(a)
    print(a + " " + b)
    let c = a + b
    print(c)
    print(c == "helloworld")
    print(c != "helloworld")
    print(b + c)
    print(shout("hey"))
    print(shout("nested"))
    print(wrap("mid", "<", ">"))
    print(count_vowels("education"))
    let long = ""
    long = long + "x"
    long = long + "y" + "z"
    print(long)
    print(shout(long))
    print(wrap(shout(wrap("q", "[", "]")), "(", ")"))
    let m = "hello world"
    print(length(m))
    print(length(""))
    print(substring(m, 0, 5))
    print(substring(m, 6, 11))
    print(m[0])
    print(m[6])
    print(m[length(m) - 1])
    print(ord('a'))
    print(ord('A'))
    print(chr(97))
    print(chr(ord(m[0])))
    print(chr(ord(a[0])))
    let sliced = substring(a, 1, 3)
    print(sliced)
    print(sliced + "z")
    print(length(sliced))
    print(sliced == "el")
    return 0
}
