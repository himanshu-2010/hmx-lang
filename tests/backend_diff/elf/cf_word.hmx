fn main() -> int {
    if (1 < 2) {
        print(1)
    } else {
        print(2)
    }
    if (2 < 1) {
        print(3)
    } else {
        print(4)
    }
    if (2 < 1) {
        print(9)
    }
    let n = 0
    while (n < 3) {
        print(n)
        n += 1
    }
    let m = 0
    do {
        m += 1
        print(m)
    } while (m < 3)
    for (let i = 5; i < 8; i += 1) {
        print(i)
    }
    for (let i = 3; i > 1; i -= 1) {
        print(i)
    }
    let steps = 0
    loop (2) {
        print(5)
        steps += 1
    }
    print(steps)
    let i = 0
    while (true) {
        i += 1
        if (i == 3) {
            break
        }
        print(6)
    }
    print(i)
    let hits = 0
    for (let k = 0; k < 4; k += 1) {
        if (k % 2 == 0) {
            continue
        }
        hits += 1
    }
    print(hits)
    let a = 0
    let b = 0
    loop (3) {
        a += 1
        let inner = 0
        while (inner < 2) {
            inner += 1
            b += 1
            if (inner == 2) {
                break
            }
        }
    }
    print(a)
    print(b)
    return 0
}
